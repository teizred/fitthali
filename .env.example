ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Code d'accès pour protéger les routes API en production (à saisir dans Réglages)
APP_CODE=

# Notifications du minuteur sur Vercel (serverless) : Upstash QStash (gratuit)
# console.upstash.com → QStash → copie les 4 valeurs. Laisse vide en local (minuteurs en mémoire).
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# URL publique de prod (ex : https://fitthali.vercel.app) pour le rappel QStash
APP_URL=
